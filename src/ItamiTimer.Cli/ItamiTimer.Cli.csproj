<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line layer: no UI, can run standalone, prints one colour block per minute.
    Doubles as a test fixture for Core and a data source for the App rendering layer (UI
    and logic are kept separate — the logic exists before the UI does, and can run
    independently of it).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>itami</AssemblyName>
    <RootNamespace>ItamiTimer.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItamiTimer.Core\ItamiTimer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keyboard/mouse idle reading (§8.3.6) is needed by both App and Cli. The source
         lives in App (§8.5: platform-specific code belongs to that layer), and is linked
         in here — the same file compiled on both sides, not copied. -->

    <!-- executeCommand 的执行、日志、数据目录：`itami commands` 试跑功能的**全部价值**
         就在于它跑的必须是 App 到点时跑的那一条路径。这里 link 的是同一份源文件，不是抄
         一份：抄一份的话两边会各自漂移，CLI 测过了 App 照样能坏，2026-08-08 那个引号
         bug（DECISIONS L1）就正好是这种「只在 App 那条路上才犯」的错。
         三个文件都零 Avalonia 依赖，链条是 Command → Log → AppData。 -->
    <Compile Include="..\ItamiTimer.App\Platform\Command.cs" Link="Shared\Command.cs" />
    <Compile Include="..\ItamiTimer.App\Log.cs" Link="Shared\Log.cs" />
    <Compile Include="..\ItamiTimer.App\AppData.cs" Link="Shared\AppData.cs" />
    <!-- settings.json 只为读 awBaseUrl（DESIGN §11.1）：把 AW 挪过端口的用户，界面能用
         而干跑连不上，又一例「验证工具跟被验证对象不一致」。2026-08-30 把 Settings.cs 里
         「挑默认提示音」那段拆去 SettingsDefaults.cs 之后它才零平台依赖、link 得进来；
         **不要改成 CLI 自己 JsonDocument 读一遍那个字段**——那是「一个文件两条读取路径」，
         §15.4 里 executeCommand 被这么咬过两次。 -->
    <Compile Include="..\ItamiTimer.App\Settings.cs" Link="Shared\Settings.cs" />
    <!-- during.json 只为读 checkpoint（§11.2）：backfill 的起点必须跟界面一致，
         否则干跑算的是"首次全量"而界面算的是"上次 checkpoint 到现在"，两个数没有
         可比性。⚠️ CLI **只读不写**——推进 checkpoint 是界面点 Start 那一刻唯一的
         写入点（§11.2），干跑绝不能碰它。 -->
    <Compile Include="..\ItamiTimer.App\During.cs" Link="Shared\During.cs" />
  </ItemGroup>

</Project>
