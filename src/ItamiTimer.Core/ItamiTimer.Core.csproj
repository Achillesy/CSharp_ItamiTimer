<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The first boundary rule of this project's layering: modules 1-6 (AwClient / GroupRules /
    TaskRecord / TaskEvaluator / TaskStore / Settings) contain no UI code and
    no Win32 calls at all.

    net10.0 (no -windows suffix) lets the compiler block off the UI half: desktop
    SDKs like WinForms / WPF / Avalonia simply can't be referenced under this
    target. Never add UseWindowsForms, UseWPF, or any UI package reference to
    this project.

    ⚠️ But to be precise: net10.0 does NOT block P/Invoke — [DllImport("user32.dll")]
    compiles here just fine. So "no touching Win32" is a matter of DISCIPLINE,
    not something the compiler enforces. When a platform-specific call is
    needed (pinning without stealing focus, reading keyboard/mouse idle time),
    write it in ItamiTimer.App or Cli — don't take the shortcut of dropping it
    in here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
