<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ItamiTimer.App.SettingsWindow"
        Title="Settings"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        Background="#D7DBE0">
  <!-- Topmost：主窗口可能被用户用图钉钉住了（§8.3.7），那时普通的模态窗口会
       整个沉到它下面 —— 屏幕上什么都不出现，点了齿轮像没反应。模态窗口本来
       就该压在一切之上，直接钉死。2026-07-28 实测撞到。 -->

  <Window.Styles>
    <!-- 一张卡片 = 一条设置。照 Windows 时钟应用的设置页排。
         **一个字的说明都没有**（用户 2026-07-28）：标题 + 控件，剩下的自己猜 ——
         跟主界面分割线以下不给提示字、不给数字是同一条。 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#E8EBEE"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="BorderBrush" Value="#C7CDD4"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="22,18,22,20" Spacing="12">

    <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Focus complete"/>
          <ToggleSwitch x:Name="FocusOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off"/>
        </Grid>
        <ComboBox x:Name="FocusSound" HorizontalAlignment="Stretch" MaxDropDownHeight="320"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Break over"/>
          <ToggleSwitch x:Name="RestOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off"/>
        </Grid>
        <ComboBox x:Name="RestSound" HorizontalAlignment="Stretch" MaxDropDownHeight="320"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="Idle nudge"/>
          <ToggleSwitch x:Name="IdleOn" Grid.Column="1" VerticalAlignment="Center"
                        OnContent="On" OffContent="Off"/>
        </Grid>
        <ComboBox x:Name="IdleSound" HorizontalAlignment="Stretch" MaxDropDownHeight="320"/>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,*">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
            <TextBlock Classes="title" Text="Shutdown"/>
            <ToggleSwitch x:Name="ShutdownOn" Grid.Column="1" HorizontalAlignment="Right"
                          VerticalAlignment="Center" OnContent="On" OffContent="Off"/>
          </Grid>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,0,0,0">
            <TextBlock Classes="title" Text="Alarm"/>
            <ToggleSwitch x:Name="AlarmOn" Grid.Column="1" HorizontalAlignment="Right"
                          VerticalAlignment="Center" OnContent="On" OffContent="Off"/>
          </Grid>
        </Grid>
        <ComboBox x:Name="AlarmSound" HorizontalAlignment="Stretch" MaxDropDownHeight="320"/>
      </StackPanel>
    </Border>

    <!-- 滴答**只有音量**，没有开关（用户 2026-07-28）：开关是钟上那个喇叭，
         滴答是钟本身的功能，跟督促学习无关，不该混进这一页。 -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="title" Text="Tick volume"/>
        <Slider x:Name="TickVol" Minimum="0" Maximum="100" TickFrequency="10"
                IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Border>

  </StackPanel>
</Window>
