<!--
  ⚠️ Name must be ItamiTimer, and that is NOT for cosmetic reasons.

  This is exactly the name macOS's aw-watcher-window reports as data.app (not the process
  name, and not Info.plist's CFBundleName). Avalonia defaults to "Avalonia Application"
  when Name isn't set — hit in practice on 2026-07-28: ActivityWatch dutifully recorded
  app='Avalonia Application', which doesn't match the "ItamiTimer" goal in the default
  rules.json (§5), so the app itself could never be recognized as on-task.

  The consequence is exactly the deadlock warned about in GroupRules's own comments: the
  user glances at their own progress, ItamiTimer becomes the active window, it gets judged
  OffTask, and the cell turns red. Same rule, same reasoning as pinning AssemblyName to
  ItamiTimer on the Windows side — just a different knob.

  As a side effect, this also fixes the app name shown in the top-left of the macOS menu bar.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ItamiTimer.App.App"
             Name="ItamiTimer"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
