<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ItamiTimer.App"
        x:Class="ItamiTimer.App.MainWindow"
        Title="一袋米要扛几楼"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#D7DBE0">

  <Window.Styles>
    <!-- 「开始」既是按钮也是分割线：它以上是给眼睛的，以下是给手的 -->
    <Style Selector="Button.start">
      <Setter Property="Height" Value="42"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.start /template/ ContentPresenter">
      <Setter Property="Background" Value="#2FA36B"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3BBA7D"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#AEB6BF"/>
      <Setter Property="Foreground" Value="#E4E8EC"/>
    </Style>

    <!-- 放弃是危险动作，用偷懒那个红（§8.2.3 的 slack） -->
    <Style Selector="Button.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="#D6453F"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- 齿轮：唯一一个不属于「任务」的控件，所以画得尽量轻 -->
    <Style Selector="Button.gear">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Opacity" Value="0.45"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="15"/>
    </Style>
    <Style Selector="Button.gear:pointerover">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- 右上角那两个即时开关：喇叭（总静音）、图钉（置顶）。
         跟齿轮同一族的字形，用 Windows 自带的图标字体，不打包任何图片。
         关着的时候淡、开着的时候实 —— 状态一眼就看得出来。 -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Opacity" Value="0.40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.chrome.on">
      <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="18,14,18,16">

    <!-- 表盘。任务进行中它是全部；空盘时它就是下一轮的邀请（§8.4.5a）。
         右上角压两个即时开关：先喇叭后图钉（用户 2026-07-28 指定的顺序）。
         钟是圆的，右上角那块是空的，正好摆。 -->
    <Grid>
      <app:DialControl x:Name="Dial" Height="330"/>
      <StackPanel Orientation="Horizontal" Spacing="2"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
        <Button x:Name="MuteBtn" Classes="chrome" ToolTip.Tip="静音"/>
        <Button x:Name="PinBtn" Classes="chrome" ToolTip.Tip="置顶"/>
      </StackPanel>
    </Grid>

    <!-- 七块骨牌 = 星期几。倒下几块就是周几，一个字都没有 -->
    <app:DominoRow x:Name="Dominoes" Height="76" Margin="0,2,0,10"/>

    <!-- ↓↓↓ 分割线以下：连不上 AW 时整块变灰，这个程序就只是一个钟（§6.2） -->
    <StackPanel x:Name="Controls" Spacing="10">

      <Button x:Name="StartBtn" Classes="start" Click="OnStart" Content="开始"/>

      <!-- 取值控件。不解释、不说明、连数字都不给（用户 2026-07-27：主打一个猜）。
           自己拖去。

           ⚠️ 【调试量程】2~10 分钟、步进 1、默认 5（用户 2026-07-27）。
           跑一轮完整任务只要五分钟，不用真坐 25 分钟才看到达成那一刻。
           **调通之后要改回 §10 的正式量程：Minimum=10 Maximum=50
           TickFrequency=5 Value=25**。这里是本文件里唯一一处临时值。 -->
      <Slider x:Name="Minutes" Margin="2,4,2,0"
              Minimum="2" Maximum="10" TickFrequency="1"
              IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="5"/>

      <!-- 小目标列表 + 齿轮。rules.json 有几个就排几行，窗口高度跟着变。
           任务进行中仍然可点：补勾一个小目标是【追溯生效】的（§5.4）。
           齿轮压在同一行的右端，不额外占一行高度。 -->
      <Grid ColumnDefinitions="*,Auto">
        <ItemsControl x:Name="Goals"/>
        <Button x:Name="SettingsBtn" Grid.Column="1" Classes="gear" Content="⚙"
                VerticalAlignment="Bottom" ToolTip.Tip="设置"/>
      </Grid>

    </StackPanel>
  </StackPanel>
</Window>
