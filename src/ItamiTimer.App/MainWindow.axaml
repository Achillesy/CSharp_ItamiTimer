<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ItamiTimer.App"
        x:Class="ItamiTimer.App.MainWindow"
        Title="一袋米要扛几楼"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <!-- DECISIONS K（改稿）：无边框、透明背景是**整扇主窗口**的属性，不是另开一扇挂件——
       所有功能原样保留，只是外框和窗口底色没了。没有标题栏之后窗口本身没法拖了，靠
       MainWindow.axaml.cs 里挂在 Dial 控件（不是整个 Window）上的
       PointerPressed -> BeginMoveDrag 补上——拖动生效范围收窄到表盘本身，用的是 Dial
       自己的矩形 Bounds 当命中范围（用户 2026-08-08 要求"仅仅点在表盘区域才有效"）。 -->

  <Window.Styles>
    <!-- "Start" is both a button and the dividing line: above it is for the eyes, below it
         is for the hand.

         ⚠️ Padding=0 and VerticalContentAlignment=Center MUST be set together, otherwise
         the text sits pinned to the top edge (surfaced 2026-07-28 after switching to
         English). Fluent's default Button padding is asymmetric top/bottom, and combined
         with a fixed Height that pushes the content upward.

         Why nobody noticed while the text was Chinese: CJK glyphs fill their entire em box
         and their visual centre already sits in the middle of the line box, so the offset
         got absorbed; switch to English and capital letters sit high with empty descender
         space below, and the same offset becomes immediately visible. The gear and chrome
         styles were always correct — copy them. -->
    <Style Selector="Button.start">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.start /template/ ContentPresenter">
      <Setter Property="Background" Value="#2FA36B"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3BBA7D"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <!-- 禁用态是中性色，跟着主题走（v3.0.0，DESIGN §8.8）；绿和红是语义色，不跟。 -->
    <Style Selector="Button.start:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ItamiStartDisabledBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ItamiStartDisabledForeground}"/>
    </Style>

    <!-- "Give up" is a dangerous action, coloured red on its own (requested by the user on the evening of 2026-07-28).

         ⚠️ These rules MUST come after the .start group above: Avalonia styles of equal
         priority apply in declaration order, and the later one wins. Moving this earlier
         would get overridden by the green style, with no error raised at all.

         Only "Give up" is red; "New round" isn't — the latter follows a reward ending and
         starting the next one, not a dangerous action. The switch happens in
         RefreshStartButton(), one line, Classes.Set.

         The colour value is taken from the dial's slack red (§8.2.3). This is the only
         place that red ever leaves the dial: on the dial it means "this minute was
         off-task", here it means "this click voids the whole round" — both are "this
         isn't the outcome you wanted", so the meaning still lines up. -->
    <Style Selector="Button.start.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="#D6453F"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E15C56"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>


    <!-- The two instant toggles in the top-right corner: the speaker (tick), the pin
         (always on top). The shapes are drawn as vectors (ChromeIcons.cs), no bundled
         images and no dependency on any icon font — the previous Segoe Fluent Icons only
         exist on Windows and render as tofu boxes on macOS. Faint when off, solid when on
         — the state is legible at a glance. -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Opacity" Value="0.40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.chrome.on">
      <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
  </Window.Styles>

  <Grid Margin="18,14,18,16" RowDefinitions="Auto,Auto,Auto">

    <!-- The dial. While a task is running, it's the whole story; an empty dial is the
         invitation for the next round (§8.4.5a). Two instant toggles sit in the top-right
         corner: speaker first, then pin (the order the user specified on 2026-07-28). The
         clock is round, so its top-right corner is empty space that fits them perfectly. -->
    <Grid Grid.Row="0">
      <!-- 高度由 WindowLayout.DialHeight 在构造函数里给（3.8.0 起有标准/紧凑两档，
           DESIGN §8.10）。这里刻意不写死，免得同一个量两处定义。 -->
      <app:DialControl x:Name="Dial"/>
      <StackPanel Orientation="Horizontal" Spacing="2"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
        <Button x:Name="MuteBtn" Classes="chrome" ToolTip.Tip="Ticking"/>
        <Button x:Name="PinBtn" Classes="chrome" ToolTip.Tip="Always on top"/>
      </StackPanel>
    </Grid>

    <!-- Seven dominoes = the day of the week. However many have fallen is the day, not a
         single word of it. The gear sits at this row's right end, **directly below the
         pin** (user, 2026-07-28). The reason isn't saving space, it's **adding to the
         mystery**: tucking a function button into the domino row makes the dominoes read
         more like part of some control, making "what on earth are these seven things"
         even harder to guess — the same philosophy as the slider giving no numbers and
         nothing below the divider explaining itself (§8.4.2a). -->
    <!-- 下边距是**负的**：卡片（Row 2）要紧贴骨牌底部，中间一点空都不留（用户
         2026-08-08 两次强调，DECISIONS K16）。原来这里是 10px 正边距（卡片还不存在
         时给骨牌和 Start 按钮留的呼吸感），先收到 0——但用户还是看得到一条缝，因为
         **那条缝不在布局里，在 DominoRow 自己的绘制里**：它的地面线落在控件高度的
         96.5%（`DominoRow.cs` 的 `baseY = k.H * 0.965`），76px 最底下约 2.7px 是它
         自己留的空白，阴影压根没画到那儿。
         -3 是按这段死区算出来的，实测还剩一丝白线（阴影渐变在底边淡出的尾巴，见
         DominoRow 里那段"最暗的一档不能落在底边"的注释），用户拍板收到 -4。
         ⚠️ 别把这个负边距当成"随手调的视觉微调"删掉或凑整——它跟 DominoRow 那个
         0.965 和底边的渐变淡出绑在一起，那边动了这里要跟着重算。

         **上下边距和骨牌高度都在 `WindowLayout.DominoMargin` / `DominoHeight`**
         （3.8.0 起有标准/紧凑两档，DESIGN §8.10）：标准档 76 / (2, -4)，紧凑档
         56 / (8, -3)。上边距紧凑档特意放大到 8，是给提示条留高度，理由见那边。 -->
    <Grid x:Name="DominoRowCell" Grid.Row="1">
      <app:DominoRow x:Name="Dominoes"/>

      <!-- Alarms 清单到点时叠在骨牌上的提示条（DESIGN §9.1）：程序自己画，保证
           屏幕上一定看得见，跟 Notify.Show 弹的系统通知并存，不是二选一——中间
           一度因为 Notify.cs 传的 AppId 是没注册过的裸字符串，误判成"这条路整个
           走不通"整个放弃过，后来发现只是 AppId 选错了，换成正确的就能弹，已经
           加回来（DECISIONS J9/J13）。提示条不依赖 Windows 通知设置/请勿打扰这些
           不确定因素，所以留着，两条一起触发。
           只在骨牌所在的这个 Grid 里叠一层，不单开窗口——复用现成的位置和尺寸，
           gear 图标声明在它之后所以还留在最上层、正常可点。

           ⚠️ 2026-08-06 当天好几轮现场反馈才定稿（见 DECISIONS J11）：整块矩形
           色块 → 贴着文字的小背景 → 纯文字、骨牌透出来 → 深色文字打底、蓝色文字
           错位叠在上面。两层内容完全一样，蓝色那份声明在后面所以画在最上层，
           `Margin="-2,-2,0,0"` 让它相对深色那份往左上错开一点，跟 DialControl
           画指针阴影的手法一样（先画一份偏移的，再在真实位置画一份），只是这里
           两份都是实色文字，不是"深色文字 + 阴影"那种主次关系。时间行加粗、
           文字行不加粗，两行同一套字号（先统一成时间的 18 号，再定稿收到 16 号）。

           ⚠️ **`MaxLines` / `MaxWidth` 不写在这儿，在 `WindowLayout`**（3.8.0）：
           它们是**算出来的硬上限，不是保守取值**。这条提示条跟骨牌叠在同一个 `Auto`
           高的 Grid 单元格里，撑高了就把下面的卡片顶下去，而那个负边距是按骨牌高度
           死算的（DECISIONS K16），当场作废，整个窗口会为了一条提示条跳一分钟。

           **实测**（headless 量的，不是估的）：一行 48px，两行 69px。
           标准档这一行是 76+2-4 = 74px，装得下两行，**余量只有 5px**；
           紧凑档 56+8-3 = 61px，只装得下一行，余量 13px。

           条数超出的部分由 `ShowAlarmBanner` 缀在**时间行**末尾（`23:55  +2`），
           不占新的一行；`TextTrimming` 是第二道保险，管的是单条文字太长自己折行。 -->
      <Grid x:Name="AlarmBanner" HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="False">
        <StackPanel Spacing="2">
          <TextBlock x:Name="AlarmBannerTime" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource ItamiBannerInk}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AlarmBannerText" FontSize="16" Foreground="{DynamicResource ItamiBannerInk}"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <!-- 亮蓝色用 DialPalette.Dark.Rest 那个色号——已经是这个项目里"同一色相调亮
             一档"的现成值（该颜色本身的注释是"给夜面调亮一档"），不用另外调一个新色号。 -->
        <StackPanel Spacing="2" Margin="-2,-2,0,0">
          <TextBlock x:Name="AlarmBannerTimeBlue" FontSize="18" FontWeight="Bold"
                     Foreground="#63A6E0" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AlarmBannerTextBlue" FontSize="16" Foreground="#63A6E0"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <!-- 右上角凑成 2×2（v3.0.0）：上排喇叭 + 图钉（在表盘那个 Grid 里），下排齿轮 +
           主题。**这一排的两个按钮跟上排用完全相同的结构**——同一个 Horizontal
           StackPanel、同样的 Spacing="2"、同样的右边距 -4——所以两列天然对齐，不用再
           凑数字。

           ⚠️ 齿轮原来是单独一个按钮、右边距写死 30，那个 30 是**用眼睛量出来的**
           （"落在喇叭正下方"，用户 2026-07-28；屏幕缩放让 DIP 和物理像素不是一回事，
           算不出来只能试）。现在这一排有两个按钮了，照抄上排的结构反而是**几何上精确**
           的对齐，30 那个经验值随之作废，别再照它去调。齿轮"看起来像是它把骨牌推倒的"
           这个观感来自它压在骨牌上方这个位置，不来自那 4px，改完仍然成立。
           左右顺序：齿轮在左、主题在右——主题落在图钉正下方，齿轮落在喇叭正下方。

           There used to be an AlarmBtn here (removed 2026-07-30, see the note outside this
           XAML): the alarm's press interaction moved directly onto the clock face itself
           (DialControl), no longer occupying its own icon.

           ⚠️ 齿轮上没有 ToolTip.Tip，跟另外两个 chrome 按钮不一样——它打开的模态框会把
           tooltip 留在屏幕上（DECISIONS E10），别给它加回来。**主题按钮同理不加**：
           它虽然不开模态框，但一点就重画整扇窗口，tooltip 挂在旧的一版上，同一类麻烦。 -->
      <StackPanel Orientation="Horizontal" Spacing="2"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-4,0">
        <Button x:Name="SettingsBtn" Classes="chrome"/>
        <Button x:Name="ThemeBtn" Classes="chrome"/>
      </StackPanel>
    </Grid>

    <!-- 半透明背景卡片（用户 2026-08-08 三次定稿：90% 不透明度，从骨牌最下边开始，
         包住 Start 按钮、滑块、目标列表、版权/版本号，内部四边统一 12px 留白）。
         Grid.Row="2"，紧接着骨牌所在的 Row 1，两行之间没有额外间隔——Grid 的行与行
         默认贴着排，不用像之前（DECISIONS K16）那样手动算 Margin 去够到骨牌下边缘，
         这版直接更省事。
         **卡片内部只有一个间距数字 8**：`Border.Padding`（四边内边距）和 StackPanel
         的 `Spacing`（控件之间）取同一个值，卡片边框到控件的距离 = 控件与控件之间的
         距离，整张卡片一套节奏。中间试过 12/12（用户："内边界显大"）和 8/12（边距
         和控件间距不一致），定稿是两边都取 8。 -->
    <Border Grid.Row="2" Background="{DynamicResource ItamiCardBackground}" CornerRadius="10" Padding="8">
      <StackPanel x:Name="Controls" Spacing="8">

        <Button x:Name="StartBtn" Classes="start" Click="OnStart" Content="Start"/>

        <!-- The value control. No explanation, no label, not even a number (user,
             2026-07-27: the whole point is guessing). Just nine tick marks, drag it yourself.

             §8.4.2a's real range: 10-50 minutes, step 5, default 25.
             (Between 2026-07-27 and 07-28 this was temporarily 2-10 minutes, so you didn't
             have to sit through a real 25 minutes every time just to see the completion
             moment — changed back once the core loop was working.) -->
        <Slider x:Name="Minutes" Margin="2,4,2,0"
                Minimum="10" Maximum="50" TickFrequency="5"
                IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="25"/>

        <!-- The goal list. As many rows as rules.json has goals, and the window height
             follows along. -->
        <ItemsControl x:Name="Goals">
          <ItemsControl.Styles>
            <Style Selector="ItemsControl#Goals ContentPresenter">
              <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
          </ItemsControl.Styles>
        </ItemsControl>

        <!-- Moved here from SettingsWindow (user, 2026-08-07): during the Alarms 清单 testing
             round it became clear that not being able to see the running version without
             opening Settings made it hard to tell whether a stray old build was still
             running, exactly the kind of mix-up this line exists to prevent, so it belongs
             where it's seen without an extra click. -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="©️2026 Achilles.Newman" HorizontalAlignment="Center" FontSize="11" Opacity="0.4"/>
          <TextBlock x:Name="VersionLabel" Grid.Column="1" HorizontalAlignment="Right" FontSize="11" Opacity="0.4"/>
        </Grid>

      </StackPanel>
    </Border>
  </Grid>
</Window>
