<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ItamiTimer.App"
        x:Class="ItamiTimer.App.MainWindow"
        Title="一袋米要扛几楼"
        Width="380" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="18">

    <!-- 表盘。任务进行中它是全部；空盘时它就是下一轮的邀请（§8.4.5a） -->
    <app:DialControl x:Name="Dial" DockPanel.Dock="Top" Height="330"/>

    <TextBlock x:Name="Status" DockPanel.Dock="Top" Margin="0,10,0,0"
               HorizontalAlignment="Center" FontSize="14"/>

    <!-- 底部：开始任务的控件。任务进行中隐藏 -->
    <StackPanel x:Name="Setup" DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">

      <TextBlock Text="这一轮做什么" FontWeight="SemiBold" FontSize="13" Opacity="0.8"/>
      <!-- 勾选的是【小目标】，不是 app 或 title —— 后者只能手改 rules.json（§5.2） -->
      <ItemsControl x:Name="Goals"/>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Column="0" Text="专注" VerticalAlignment="Center" Opacity="0.8"/>
        <!-- §8.4.2a：10~50 分钟，步进 5，九个档 -->
        <Slider Grid.Column="1" x:Name="Minutes" Margin="10,0"
                Minimum="10" Maximum="50" TickFrequency="5"
                IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="25"/>
        <TextBlock Grid.Column="2" x:Name="MinutesText" VerticalAlignment="Center"
                   FontFamily="Consolas" MinWidth="86"/>
      </Grid>

      <Button x:Name="StartBtn" Click="OnStart" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Content="开始"/>
      <TextBlock x:Name="Hint" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
    </StackPanel>

    <Border/>
  </DockPanel>
</Window>
