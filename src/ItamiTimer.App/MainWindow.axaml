<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ItamiTimer.App"
        x:Class="ItamiTimer.App.MainWindow"
        Title="一袋米要扛几楼"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#D7DBE0">

  <Window.Styles>
    <!-- 「开始」既是按钮也是分割线：它以上是给眼睛的，以下是给手的。

         ⚠️ Padding=0 + VerticalContentAlignment=Center 这两条【必须一起写】，
         否则文字会顶着上边（2026-07-28 改英文后暴露）。Fluent 主题给 Button 的
         默认 Padding 上下不对称，配上固定 Height 就把内容挤上去了。

         为什么中文时期没人发现：汉字字形占满整个 em 框，视觉重心本来就在行盒
         中间，偏移被吃掉了；换成英文，大写字母偏上、底下的降部空间又空着，
         同样的偏移立刻看得出来。gear 和 chrome 两个样式一直是对的，照它们写。 -->
    <Style Selector="Button.start">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.start /template/ ContentPresenter">
      <Setter Property="Background" Value="#2FA36B"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3BBA7D"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#AEB6BF"/>
      <Setter Property="Foreground" Value="#E4E8EC"/>
    </Style>

    <!-- 「放弃」是危险动作，单独染红（用户 2026-07-28 傍晚要的）。

         ⚠️ 这几条【必须排在上面那组 .start 之后】：Avalonia 同优先级的样式按声明
         顺序生效，后来者赢。挪到前面去就会被绿色盖掉，而且不报任何错。

         只有「放弃」染红，「开始新一轮」不染 —— 后者是奖励结束、开下一轮，不是
         危险动作。切换在 RefreshStartButton() 里，一行 Classes.Set。

         色值取自表盘的 slack 红（§8.2.3）。这是这个红唯一一次离开表盘：它在盘上
         的意思是"这一分钟偷懒了"，在这里是"这一下会作废整轮"—— 两处都是"这不
         是你想要的结果"，语义对得上。 -->
    <Style Selector="Button.start.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="#D6453F"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.start.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E15C56"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>


    <!-- 右上角那两个即时开关：喇叭（滴答声）、图钉（置顶）。
         图形是【矢量画的】（ChromeIcons.cs），不打包图片、也不依赖任何图标字体——
         原来用的 Segoe Fluent Icons 只有 Windows 有，macOS 上是豆腐块。
         关着的时候淡、开着的时候实 —— 状态一眼就看得出来。 -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Opacity" Value="0.40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.chrome.on">
      <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="18,14,18,16">

    <!-- 表盘。任务进行中它是全部；空盘时它就是下一轮的邀请（§8.4.5a）。
         右上角压两个即时开关：先喇叭后图钉（用户 2026-07-28 指定的顺序）。
         钟是圆的，右上角那块是空的，正好摆。 -->
    <Grid>
      <app:DialControl x:Name="Dial" Height="330"/>
      <StackPanel Orientation="Horizontal" Spacing="2"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
        <Button x:Name="MuteBtn" Classes="chrome" ToolTip.Tip="Ticking"/>
        <Button x:Name="PinBtn" Classes="chrome" ToolTip.Tip="Always on top"/>
      </StackPanel>
    </Grid>

    <!-- 七块骨牌 = 星期几。倒下几块就是周几，一个字都没有。
         齿轮压在这一行的右端、**图钉正下方**（用户 2026-07-28）。理由不是省地方，
         是**增加迷惑性**：把一个功能按钮塞进骨牌这一行，骨牌就更像某种控件的
         一部分，"这七块东西到底是什么"就更猜不出来了 —— 跟滑块不给数字、
         分割线以下不给提示字是同一条（§8.4.2a）。 -->
    <Grid Margin="0,2,0,10">
      <app:DominoRow x:Name="Dominoes" Height="76"/>
      <!-- 右边距 26（DIP）让齿轮正落在**喇叭**的正下方，也正落在倒下那几块骨牌的
           上方 —— 看起来就像是它把骨牌推倒的（用户 2026-07-28 晚）。
           数字是量出来的，不是算出来的：图钉那一档是 -4，两者相差一个喇叭宽 +
           间距，但屏幕缩放会把 DIP 和物理像素岔开，所以按实测调到对齐为止。 -->
      <Button x:Name="SettingsBtn" Classes="chrome"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,26,0"
              ToolTip.Tip="Settings"/>
    </Grid>

    <!-- ↓↓↓ 分割线以下：连不上 AW 时整块变灰，这个程序就只是一个钟（§6.2） -->
    <StackPanel x:Name="Controls" Spacing="10">

      <Button x:Name="StartBtn" Classes="start" Click="OnStart" Content="Start"/>

      <!-- 取值控件。不解释、不说明、连数字都不给（用户 2026-07-27：主打一个猜）。
           只有九个刻度，自己拖去。

           §8.4.2a 的正式量程：10~50 分钟、步进 5、默认 25。
           （2026-07-27~28 期间这里临时是 2~10 分钟，为了不用每次真坐 25 分钟
           才看到达成那一刻；核心循环跑通后已经改回来了。） -->
      <Slider x:Name="Minutes" Margin="2,4,2,0"
              Minimum="10" Maximum="50" TickFrequency="5"
              IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="25"/>

      <!-- 小目标列表。rules.json 有几个就排几行，窗口高度跟着变。
           任务进行中仍然可点：补勾一个小目标是【追溯生效】的（§5.4）。
           番茄钟模式下整个隐藏（§11.1 第 3 条）。 -->
      <ItemsControl x:Name="Goals"/>

    </StackPanel>
  </StackPanel>
</Window>
