<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The UI layer. Avalonia 12.

    ⚠️ AssemblyName must be pinned to ItamiTimer: it's exactly the exe name that
    ActivityWatch reports as data.app, and the default rules.json matches an
    "ItamiTimer" goal against it so the app itself can be recognized as on-task. Change
    this and the program starts judging itself as OffTask, falling into a "nudge -> the
    user looks at the nudge -> off-task again -> nudge again" loop. Changing the csproj is
    exactly the moment this line is most likely to get lost.

    net10.0 (the -windows suffix was dropped on 2026-07-28): this is the only layer allowed
    to contain platform calls (pinning, reading keyboard/mouse idle time, playing sound).
    Core stays net10.0 and contains no P/Invoke.

    ⚠️ **Why the -windows suffix was dropped**: it never actually did anything for this
    project — Core's own csproj says outright that "net10.0 doesn't block P/Invoke", so all
    -windows bought was a platform-analyzer context. Dropping it means CA1416 actually
    **starts reporting** unguarded platform calls, a net win. Platform-specific code is
    uniformly guarded with [SupportedOSPlatform] attributes plus OperatingSystem.IsXxx()
    checks, so both sides compile.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ItamiTimer</AssemblyName>
    <RootNamespace>ItamiTimer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The exe's file icon (seen by the desktop shortcut, Explorer, Alt-Tab). The icon shown
      in the window is drawn at runtime, using the same artwork as this one.

      tomato.ico is exported from TomatoIcon by IconExport (see the command-line switches
      in Program.cs); the .ico in the repository is only the export's output — the bitmap
      isn't hand-drawn, it's drawn in code. To change the tomato's shape, edit TomatoIcon.cs
      and re-export.
    -->
    <ApplicationIcon>tomato.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!--
      Used by the three debug exits (dial-specimens / export-icon / export-iconset); the
      normal startup path never touches it. They only draw onto a RenderTargetBitmap and
      don't need a windowing platform; UsePlatformDetect would go initialize the native
      windowing system and crash outright in an environment with no graphical session (CI,
      a plain SSH session). See the HeadlessBuilder comment in Program.cs for details.
      Note that pack-macos.sh depends on export-iconset, so this directly determines
      whether packaging can run on CI.
    -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItamiTimer.Core\ItamiTimer.Core.csproj" />

    <!--
      闹钟到点时 App 起一个 shell 去跑 **同目录下的** itami.exe（DECISIONS L19/L22，
      规格见 DESIGN §9.3）。安装包那条路由 pack-windows.ps1 把两个项目 publish 到同一个
      目录来保证；**本地从 bin\Debug 跑的那条路要靠这个引用 + 下面的拷贝 target**。

      ⚠️ 不加的话症状很温和、也很容易被当成功能没做：闹钟到点，日志里只有一句
      "cannot find the itami CLI"，命令一条都不执行——而 CLAUDE.md 规定本地验证正是跑
      bin\Debug 的产物，也就是说**这个功能只在装机之后才能测**。项目自己的 F5 说得很
      清楚：凡是「必须记得做」的手工步骤（比如"测之前记得把 itami.exe 拷过来"），就是
      迟早会被忘掉的步骤。

      ReferenceOutputAssembly=false：只要构建顺序，不要把 itami.dll 当程序集引用进来
      （两个项目各自编译了同一份 Command.cs，真引用进来会撞类型）。
      没有循环依赖：Cli 是用 <Compile Include> link App 的源文件，不是项目引用。
    -->
    <ProjectReference Include="..\ItamiTimer.Cli\ItamiTimer.Cli.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    把 itami.* 拷到 App 的输出目录，让 bin\Debug / bin\Release 的布局跟安装目录一致。

    路径不写死，问 Cli 项目自己的 GetTargetPath 要——写死 bin\$(Configuration)\net10.0
    在带 RID 的构建里就不对了（那时输出在 …\net10.0\win-x64\）。

    只挂 Build：publish 那条路由打包脚本显式 publish CLI 到同一个 StageDir，不靠这里。
  -->
  <Target Name="CopyItamiCliNextToApp" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ItamiTimer.Cli\ItamiTimer.Cli.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_ItamiCliDll" />
    </MSBuild>
    <ItemGroup>
      <_ItamiCliFiles Include="%(_ItamiCliDll.RootDir)%(_ItamiCliDll.Directory)itami.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ItamiCliFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="Copied @(_ItamiCliFiles->Count()) itami CLI file(s) next to the app" />
  </Target>

  <!--
    The rules file needs to travel with the exe, otherwise the published program can't find
    it (see AppData.RulesPath).

    This copy is the **default rules shipped with the program**. The user's own copy lives
    at %LOCALAPPDATA%\ItamiTimer\ and takes priority, so republishing never overwrites any
    goals they've added.
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\rules.json"
             Link="rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Strips debug symbols from the publish output: 127MB -> 27MB.

    That 100MB gap comes down to exactly two files — libSkiaSharp.pdb at 80MB and
    libHarfBuzzSharp.pdb at 20MB. They're pulled in by the SkiaSharp / HarfBuzzSharp native
    NuGet packages, and `dotnet publish` just copies a package's contents to the output
    directory as-is — **it strips nothing on its own**.

    Why this lives in the csproj instead of a documented step to remember: that step was
    already forgotten once. The README used to have a single publish command,
    and running it as written produced 127MB with no hint anything was wrong — a manual
    step that "must be remembered" is a step that eventually gets forgotten. With this here,
    27MB is simply what the publish command produces, benefiting both the Windows and macOS
    lines at once.

    This project's own two pdbs get deleted too (a few dozen KB each, doesn't matter either
    way): Log.Error records the exception's type and message, not a stack trace, so nothing
    currently reads them. If line numbers are ever wanted in the Release log, that's a
    change to Log.Error, and this project's own pdb should be excluded from the strip then.

    Only runs after Publish, doesn't affect `dotnet build` or debugging.
  -->
  <Target Name="StripPdbFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PdbToStrip Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbToStrip)" ContinueOnError="true" />
    <Message Importance="high" Text="Stripped @(_PdbToStrip->Count()) .pdb file(s) (see StripPdbFromPublish in the csproj)" />
  </Target>

</Project>
