<Project Sdk="Microsoft.NET.Sdk">

  <!--
    界面层（DESIGN.md §8 模块 8、9）。Avalonia 12。

    ⚠️ AssemblyName 必须钉死成 ItamiTimer：AW 上报的 data.app 就是 exe 名，
    而 §5.3 第 1 步靠它硬编码自身豁免。改了这里，程序会把自己判成 OffTask，
    陷入「提醒 → 用户看提醒 → 又违规 → 再提醒」死循环。
    §8.5 专门提醒过：换 csproj 正是最容易把这行弄丢的时刻。

    net10.0（2026-07-28 去掉 -windows）：本层是唯一允许出现平台调用的地方
    （置顶、读键鼠空闲时间、放音）。Core 保持 net10.0 且不含 P/Invoke。

    ⚠️ **为什么去掉 -windows**：那个后缀对本项目其实没起作用 —— Core 的 csproj 里
    自己写着「net10.0 挡不住 P/Invoke」，所以 -windows 换来的只有平台分析器上下文。
    去掉之后 CA1416 反而会**真的开始报**没守住的平台调用，是净收益。平台专属代码
    一律 [SupportedOSPlatform] 标注 + OperatingSystem.IsXxx() 守住，两边都编得过。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ItamiTimer</AssemblyName>
    <RootNamespace>ItamiTimer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      exe 的文件图标（桌面快捷方式、资源管理器、Alt-Tab 都看它）。
      窗口里那个图标是运行时画的，跟这个是同一份美术。

      tomato.ico 由 IconExport 从 TomatoIcon 导出（命令行开关见 Program.cs），
      仓库里那个 .ico 只是导出结果 —— 位图不是手画的，是代码画的。
      番茄的形状要改就去改 TomatoIcon.cs，然后重新导一次。
    -->
    <ApplicationIcon>tomato.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItamiTimer.Core\ItamiTimer.Core.csproj" />
  </ItemGroup>

  <!--
    规则文件要跟着 exe 走，否则发布出去的程序找不到它（见 AppData.RulesPath）。

    这份是**随程序发布的默认规则**。用户自己那份在 %LOCALAPPDATA%\ItamiTimer\，
    优先级更高，所以重新发布不会冲掉他加的小目标。
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\rules.json"
             Link="rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
